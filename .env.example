# Consolith Environment Variables Template (.env)
# Copy this file to .env and configure for your local or production environment.

# ==============================================================================
# 1. Environment & Core Application Settings
# ==============================================================================
PROJECT_NAME="Consolith API"
ENVIRONMENT=development               # Options: 'development', 'staging', 'production'
DEBUG=True                            # Must be False in production

# ==============================================================================
# 2. PostgreSQL Database Configuration (Forced RLS Enabled)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=consolith
# Dedicated non-superuser role used at runtime by the application
DATABASE_URL=postgresql://consolith_app:consolith_secure_app_pw@localhost:5432/consolith

# ==============================================================================
# 3. Vector Database (Qdrant)
# ==============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_KNOWLEDGE_COLLECTION=consolith_knowledge
QDRANT_FORMS_COLLECTION=consolith_forms

# ==============================================================================
# 4. Authentication (Firebase & RBAC)
# ==============================================================================
FIREBASE_PROJECT_ID=consolith-dev
FIREBASE_SERVICE_ACCOUNT_PATH=        # Path to service-account.json (optional in dev, required in prod)
FIREBASE_AUTH_EMULATOR_HOST=          # Set if using local Firebase auth emulator
ADMIN_GMAIL=admin.demo@gmail.com      # Pre-configured bootstrap admin email
TEST_MODE_ALLOW_SIMULATED_TOKENS=False # MUST be False in production; only True in isolated dev test suites

# ==============================================================================
# 5. Data Privacy & Field-Level Encryption
# ==============================================================================
# Fernet 32-byte urlsafe base64 key for encrypting sensitive fields at rest (e.g. Aadhaar masking cache)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=consolith_dev_fernet_secret_key_32_bytes_len=

# Document Storage & Upload Policy
STORAGE_TEMP_DIR=/tmp/consolith/temp_docs
STORAGE_RETENTION_POLICY=delete_after_ocr  # Strictly complies with Aadhaar privacy regulations

# ==============================================================================
# 6. AI & Knowledge Base (Google Gemini & RAG)
# ==============================================================================
GEMINI_API_KEY=                       # Required for live AI assistance and dynamic form drafting
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=BAAI/bge-m3
RAG_MIN_RELEVANCE=0.55                # Rejection floor to prevent hallucinations

# ==============================================================================
# 7. Frontend Client Configuration
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDummyKeyForConsolithDevOnly
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=consolith-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=consolith-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=consolith-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ==============================================================================
# 8. Module 9: Ed25519 Digital Signatures & PKI Keystore Configuration
# ==============================================================================
# In local development, Consolith automatically uses DevSigningKeyProvider with 
# deterministic in-memory Ed25519 key derivation (seeds). No external credentials required.
#
# Production Setup:
# For production deployments, integrate with a Hardware Security Module (HSM) or
# Cloud Key Management Service (AWS KMS, GCP Cloud KMS, or HashiCorp Vault Transit).
# Private keys must NEVER be stored in plain text, database tables, or repository commits.
PKI_SIGNING_BACKEND=development       # Options: 'development', 'aws_kms', 'gcp_kms', 'vault'
PKI_DEFAULT_KEY_ID=consolith-officer-key-2026-v1
# PKI_KMS_KEY_ARN=                    # Required if PKI_SIGNING_BACKEND=aws_kms
# PKI_VAULT_ADDR=                     # Required if PKI_SIGNING_BACKEND=vault
# PKI_VAULT_TOKEN=                    # Required if PKI_SIGNING_BACKEND=vault

# ==============================================================================
# 9. Email Verification Service (Resend)
# ==============================================================================
# Optional in local dev (uses simulated OTP dispatch); required in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
EMAIL_OTP_EXPIRY_SECONDS=300
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5

# ==============================================================================
# 10. Subdomain & Routing Configuration
# ==============================================================================
# Configure the administrator subdomain (e.g. admin.consolith.in or admin.localhost:3000)
NEXT_PUBLIC_ADMIN_DOMAIN=admin.localhost:3000
