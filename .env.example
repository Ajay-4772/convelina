# Consolith Local Environment Variables

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=consolith
DATABASE_URL=postgresql://consolith_app:consolith_secure_app_pw@localhost:5432/consolith

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==============================================================================
# Module 9: Ed25519 Digital Signatures & PKI Keystore Configuration
# ==============================================================================
# In local development, Consolith automatically uses DevSigningKeyProvider with 
# deterministic in-memory Ed25519 key derivation (seeds). No external credentials required.
#
# Production Setup:
# For production deployments, integrate with a Hardware Security Module (HSM) or
# Cloud Key Management Service (AWS KMS, GCP Cloud KMS, or HashiCorp Vault Transit).
# Private keys must NEVER be stored in plain text, database tables, or repository commits.
PKI_SIGNING_BACKEND=development       # Options: 'development', 'aws_kms', 'gcp_kms', 'vault'
PKI_DEFAULT_KEY_ID=consolith-officer-key-2026-v1
# PKI_KMS_KEY_ARN=                    # Required if PKI_SIGNING_BACKEND=aws_kms
# PKI_VAULT_ADDR=                     # Required if PKI_SIGNING_BACKEND=vault
# PKI_VAULT_TOKEN=                    # Required if PKI_SIGNING_BACKEND=vault
