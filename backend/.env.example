# ==============================================================================
# CONVELINA Backend Environment Variables Template
# Copy this file to backend/.env and populate with your environment settings.
# ==============================================================================

PROJECT_NAME="CONVELINA API"
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL with Forced Row-Level Security)
# Application connects via dedicated non-superuser role 'consolith_app'
DATABASE_URL=postgresql://consolith_app:consolith_secure_app_pw@localhost:5432/consolith

# ==============================================================================
# Firebase Authentication Configuration
# Source: Firebase Console -> Project Settings -> Service Accounts
# ==============================================================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/serviceAccountKey.json
# Optional: Firebase Auth Emulator Host (Defaulted to off / empty for real Firebase Auth)
FIREBASE_AUTH_EMULATOR_HOST=

# Pre-configured Administrator Account (receives 'admin' role automatically)
ADMIN_GMAIL=admin.demo@gmail.com

# Test Mode Flag (MUST be False in production and standard live testing)
TEST_MODE_ALLOW_SIMULATED_TOKENS=False

# Sensitive Data Encryption (Fernet 32-byte urlsafe base64 key)
ENCRYPTION_KEY=consolith_dev_fernet_secret_key_32_bytes_len=

# Storage & Privacy
STORAGE_TEMP_DIR=/tmp/consolith/temp_docs
STORAGE_RETENTION_POLICY=delete_after_ocr

# Vector Search Engine (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_IN_PROCESS=True
QDRANT_KNOWLEDGE_COLLECTION=consolith_knowledge
QDRANT_FORMS_COLLECTION=consolith_forms
RAG_MIN_RELEVANCE=0.55

# Optional: Email Service (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
