# ==============================================================================
# CONVELINA Frontend Environment Variables Template
# Copy this file to frontend/.env.local and populate with your Firebase credentials.
# Source: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ==============================================================================

# Backend FastAPI URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase Client Configuration (Public Web API Credentials)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourRealFirebaseApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Optional: Local Firebase Auth Emulator Host (leave empty/uncommented for real Firebase Auth)
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

